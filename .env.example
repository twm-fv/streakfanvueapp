# ---------------------------------------------------------------------------
# Streak - third-party Fanvue app
# Copy to .env.local and fill in. Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# From https://fanvue.com/developers/apps (creator account with KYC completed).
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Must exactly match a redirect URI registered on your Fanvue app, on a domain
# you own, over HTTPS with a valid certificate.
OAUTH_REDIRECT_URI=https://streak.example.com/api/oauth/callback
BASE_URL=https://streak.example.com

# Space separated. Must exactly match the scopes selected in the Fanvue UI.
# read:insights is optional - without it the earnings panel switches itself off.
OAUTH_SCOPES="read:self read:post read:insights"

# Root secret for cookie signing and token encryption. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Listing details, shown in the footer and legal pages.
VENDOR_NAME="Your Company Ltd"
SUPPORT_EMAIL=support@example.com

# --- Storage ----------------------------------------------------------------
# REQUIRED for any serverless host (Vercel, Netlify, Cloudflare): their
# filesystem is read-only and per-instance, so the default file store loses
# every token and freeze between requests. Create a free Redis database at
# upstash.com (or Vercel Marketplace -> Upstash) and paste both values.
# Leave both unset for local development and the file store is used instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional ---------------------------------------------------------------
# SESSION_COOKIE_NAME=streak_sid
# DATA_DIR=.data
# HISTORY_DAYS=140
# API_VERSION=2025-06-26
# Override only if the Fanvue docs move these endpoints.
# API_POSTS_PATH=/posts
# API_INSIGHTS_EARNINGS_PATH=/insights/earnings

# Runs the whole app on generated sample data, with no Fanvue connection at all.
# Never enable in production.
# DEMO_MODE=true
