# ---- Server ----
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# ---- Fanvue app registration ----
# Issued by the Fanvue developer platform when the app is registered.
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
# OAuth endpoints are handed over at registration time; the values below are
# placeholders, replace them with the ones in the registration email.
FANVUE_AUTHORIZE_URL=
FANVUE_TOKEN_URL=
FANVUE_API_BASE_URL=https://api.fanvue.com
FANVUE_API_VERSION=2025-06-26
FANVUE_SCOPES=openid offline_access read:media write:media
# Shared secret used to verify inbound webhook signatures.
FANVUE_WEBHOOK_SECRET=

# ---- Direct API token (verification script only, never the server) ----
# A short-lived dev-account token pasted by a human for scripts/verify-api.ts.
# Leave blank in every deployed environment.
FANVUE_DEV_ACCESS_TOKEN=

# ---- Clipping engine ----
# mock = no external calls, renders a stub clip locally. Use for offline dev.
CLIPPING_ENGINE=mock
OPUSCLIP_API_BASE_URL=https://api.opus.pro
OPUSCLIP_API_KEY=

# ---- Payments ----
# Off until the app is registered and real payment credentials exist.
PAYMENTS_ENABLED=false
CREDIT_PACK_MINUTES=30
CREDIT_PACK_PRICE_CENTS=1500

# ---- Storage ----
# 32-byte key, base64. Encrypts creator OAuth tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
DATA_DIR=./data
# Downloaded source video scratch space. Wiped after every render job.
WORK_DIR=./tmp
